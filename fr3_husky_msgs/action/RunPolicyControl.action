# Start a streaming joint-position policy controller.
string robot_name
float64 command_timeout_s
float64 max_duration_s
# Reject a policy-requested target farther than this from the measured joint position.
float64 max_policy_target_delta_rad
# Hard upper bound on one 1 kHz actuator command increment.
float64 max_actuator_step_rad
# Fractions of the FR3 per-joint velocity and acceleration limits.
float64 joint_velocity_scale
float64 joint_acceleration_scale
# Reproduce Isaac Lab RelativeJointPositionAction semantics. In this mode
# PolicyJointCommand.target_positions contains relative joint offsets, the
# absolute target is refreshed from measured q, and the legacy trajectory
# rate limiter above is bypassed.
bool isaac_relative_control
# Legacy API field; reach v2 always refreshes at the controller rate (1 kHz).
float64 relative_target_refresh_hz
bool control_gripper
---
bool success
string message
uint64 last_sequence
---
float64 command_age_s
float64 max_joint_error
uint64 last_sequence
string status
